{
  "name": "echonote",
  "version": "0.1.1",
  "private": true,
  "description": "A focused Windows desktop recorder for system audio transcription.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "proxy:start": "node server/index.js",
    "test": "npm run check:source && node --test tests/*.test.js",
    "lint": "npm run check:source && npm run format:check",
    "build": "electron-builder --win --x64",
    "media:prepare": "node scripts/prepare-media.js",
    "test:media": "node --test tests/media-decoder.integration.cjs",
    "prebuild": "node scripts/verify-media.js",
    "check:source": "node scripts/check-source.js",
    "format": "prettier --write \"{electron,src,server,config,scripts,tests}/**/*.{js,cjs,css,html,json}\" package.json .prettierrc.json \".github/**/*.yml\"",
    "format:check": "prettier --check \"{electron,src,server,config,scripts,tests}/**/*.{js,cjs,css,html,json}\" package.json .prettierrc.json \".github/**/*.yml\"",
    "test:unit": "node --test tests/*.test.js",
    "test:smoke": "node scripts/run-smoke.js",
    "verify": "npm run lint && npm test && npm run test:media && npm run test:smoke",
    "media:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-media.ps1"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "com.echonote.desktop",
    "productName": "EchoNote",
    "files": [
      "electron/**/*",
      "src/**/*",
      "config/**/*",
      "server/**/*",
      ".env.example",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/echonote.ico",
      "target": "portable"
    },
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "media",
        "filter": [
          "ffmpeg.exe",
          "LICENSE",
          "README.txt",
          "manifest.json"
        ]
      }
    ]
  }
}
